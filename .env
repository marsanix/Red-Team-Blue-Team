# Konfigurasi dev (jangan di-push ke repository publik).
# Untuk produksi, ganti semua nilai password/secret.

# ---- MySQL (dipakai container mysql) ----
MYSQL_ROOT_PASSWORD=root_pass_kelompok5
MYSQL_DATABASE=uas_db
MYSQL_USER=uas_user
MYSQL_PASSWORD=uas_pass_2026

# ---- Backend Flask (host DB = nama service di docker network) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=uas_db
DB_USER=uas_user
DB_PASSWORD=uas_pass_2026

# ---- Secret ----
FLASK_SECRET_KEY=session_secret_kelompok5_2026
# VULN: sengaja lemah & diketahui -> target brute-force JWT (hashcat -m 16500).
JWT_WEAK_SECRET=rahasia-super-lemah
