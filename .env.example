# ===== Template konfigurasi. Salin menjadi .env lalu sesuaikan. =====

# Port nginx di HOST (jalur dev/fallback). Jalur utama serangan via tailnet
# (100.x.y.z:80) tidak bergantung pada port host. Default 80; di mesin dev
# (Windows) set ke port bebas bila 80/8080 sudah dipakai, misalnya 8081.
# HTTP_PORT=80

# ---- MySQL (dipakai container mysql) ----
MYSQL_ROOT_PASSWORD=root_pass_kelompok5
MYSQL_DATABASE=uas_db
MYSQL_USER=uas_user
MYSQL_PASSWORD=uas_pass_2026

# ---- Backend Flask (host DB = nama service di docker network) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=uas_db
DB_USER=uas_user
DB_PASSWORD=uas_pass_2026

# ---- Secret ----
FLASK_SECRET_KEY=session_secret_kelompok5_2026
# VULN: sengaja lemah & diketahui -> target brute-force JWT (hashcat -m 16500).
JWT_WEAK_SECRET=rahasia-super-lemah

# ---- Tailscale (web server nginx = node tailnet) ----
# Isi dengan auth key Tailscale pada host Docker (mesin Blue Team) agar web
# server join tailnet. Red Team & Blue Team lain join ke tailnet yang sama.
# JANGAN commit auth key asli ke repo publik (file ini ter-track git).
# Biarkan kosong di mesin dev agar key tidak terpakai oleh node percobaan.
TS_AUTHKEY=
TS_HOSTNAME=uas-nginx
